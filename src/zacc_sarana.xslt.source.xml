<?sap.transform simple?>
<tt:transform xmlns:tt="http://www.sap.com/transformation-templates">
  <tt:root name="sarana"/>
  <tt:template>
    <array>
      <tt:loop ref=".sarana">
        <object>
          <num name="id">
            <tt:value ref="$ref.id"/>
          </num>
          <num name="id_group">
            <tt:value ref="$ref.id_group"/>
          </num>
          <str name="nama_rekanan">
            <tt:value ref="$ref.nama_rekanan"/>
          </str>
          <str name="alamat_rekanan">
            <tt:value ref="$ref.alamat_rekanan"/>
          </str>
          <str name="no_telp">
            <tt:value ref="$ref.no_telp"/>
          </str>
          <str name="fax">
            <tt:value ref="$ref.fax"/>
          </str>
          <num name="provinsi">
            <tt:value ref="$ref.provinsi"/>
          </num>
          <num name="kota">
            <tt:value ref="$ref.kota"/>
          </num>
          <str name="latitude">
            <tt:value ref="$ref.latitude"/>
          </str>
          <str name="longitude">
            <tt:value ref="$ref.longitude"/>
          </str>
          <bool name="status">
            <tt:value ref="$ref.status"/>
          </bool>
          <str name="logo_rekanan"/>
          <str name="created_at">
            <tt:value ref="$ref.created_at"/>
          </str>
          <str name="updated_at">
            <tt:value ref="$ref.updated_at"/>
          </str>
          <num name="deleted">
            <tt:value ref="$ref.deleted"/>
          </num>
          <str name="file_dokumen">
            <tt:value ref="$ref.file_dokumen"/>
          </str>
          <num name="badan_usaha">
            <tt:value ref="$ref.badan_usaha"/>
          </num>
          <str name="npwp">
            <tt:value ref="$ref.npwp"/>
          </str>
          <str name="id_parent">
            <tt:value ref="$ref.id_parent"/>
          </str>
        </object>
      </tt:loop>
    </array>
  </tt:template>
</tt:transform>
