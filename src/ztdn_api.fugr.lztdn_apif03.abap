FORM f_convert_json_voucher  USING p_str TYPE string
                         CHANGING p_voucher TYPE ty_order.

  DATA:   lv_json_data     TYPE string. ",
  lv_json_data = p_str.
  zcl_json=>deserialize(
        EXPORTING
          json             = lv_json_data
        CHANGING
          data             = p_voucher ).
