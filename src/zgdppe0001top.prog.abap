           bdter  LIKE resb-bdter,
           bdmng  LIKE resb-bdmng,
           meins  LIKE resb-meins,
           baugr  LIKE resb-baugr,
           vornr  LIKE resb-vornr,
           maktx  LIKE makt-maktx,
           objnr  LIKE resb-objnr,
           bstrf  LIKE marc-bstrf,
           mtart  LIKE mara-mtart,
           matkl  LIKE mara-matkl,
       END OF ta_resb,
       BEGIN OF ta_itab,
            aufnr  LIKE caufv-aufnr,
            werks  LIKE caufv-aufnr,
            plnbez LIKE caufv-plnbez,
            gstrp  LIKE caufv-gstrp,
            fevor  LIKE caufv-fevor,
            objnr  LIKE caufv-objnr,
            sttxt  LIKE caufvd-sttxt,
            charg   LIKE afpo-charg,
            matname   LIKE makt-maktx,

             rsnum  LIKE resb-rsnum,
             matnr  LIKE resb-aufnr,
             lgort  LIKE resb-lgort,
             bdter  LIKE resb-bdter,
             bdmng  LIKE resb-bdmng,
             meins  LIKE resb-meins,
             baugr  LIKE resb-baugr,
             sgtxt  LIKE resb-sgtxt,
             maktx  LIKE makt-maktx,
             bstrf  LIKE marc-bstrf,
             mtart  LIKE mara-mtart,
             matkl  LIKE mara-matkl,
       END OF ta_itab,
       BEGIN OF ta_itab1,
           chkbox(1),
           icon(4),
           rsnum  LIKE resb-rsnum,
           werks  LIKE resb-werks,
           lgort  LIKE resb-lgort,
           date   LIKE sy-datum,
           name   LIKE sy-uname,
           product(400),
           link(500),
           nomor(10),
*           Material(200),
*           Batch(200),
*           PO_NO(200),
           gstrp  LIKE caufv-gstrp,
           bdter  LIKE resb-bdter,
           matnr  LIKE resb-matnr,
           maktx  LIKE makt-maktx,
           bdmng  LIKE resb-bdmng,
           meins  LIKE resb-meins,
           sgtxt  LIKE resb-sgtxt,
           bstrf  LIKE marc-bstrf,
           mtart  LIKE mara-mtart,
           matkl  LIKE mara-matkl,
           fevor  LIKE caufv-fevor,
           aufnr  LIKE afko-aufnr,
           msg(100),
       END OF ta_itab1,
       BEGIN OF ta_matnr,
           matnr LIKE resb-matnr,
           werks LIKE resb-werks,
           lgort LIKE resb-lgort,
       END OF ta_matnr,
       BEGIN OF ta_marc,
           matnr LIKE marc-matnr,
           werks LIKE marc-werks,
           bstrf LIKE marc-bstrf,
       END OF ta_marc,
       BEGIN OF ta_mard,
           matnr    LIKE resb-matnr,
           werks    LIKE resb-werks,
           lgort    LIKE resb-lgort,
           labst    LIKE mard-labst,
           mtart    LIKE mara-mtart,
           qtymin   LIKE mard-labst,
       END OF ta_mard,
       BEGIN OF ta_makt,
           matnr LIKE makt-matnr,
           maktx LIKE makt-maktx,
           mtart LIKE mara-mtart,
           spras LIKE makt-spras,
       END OF ta_makt,
       BEGIN OF ta_link,
           rsnum  LIKE resb-rsnum,
           link(500),
       END OF ta_link,
       BEGIN OF ta_linkx,
             nomor(10),
             aufnr  LIKE resb-aufnr,
             plnbez LIKE resb-matnr,
             charg LIKE afpo-charg,
             gstrp LIKE caufv-gstrp,
             rsnum  LIKE resb-rsnum,
             maktx  LIKE makt-maktx,
             fevor  LIKE caufv-fevor,
             mtart  LIKE mara-mtart,
       END OF ta_linkx.


