           matnr   LIKE afpo-matnr,
           charg   LIKE afpo-charg,
           maktx   LIKE makt-maktx,
           mtart  LIKE mara-mtart,
       END OF ta_afpo,
       BEGIN OF ta_resb,
           matnr  LIKE resb-matnr,
           werks  LIKE resb-werks,
           lgort  LIKE resb-lgort,
