              <tt:value ref="$ref.maktx"/>
            </str>
            <str name="Plant">
              <tt:value ref="$ref.werks"/>
            </str>
            <str name="Sloc">
              <tt:value ref="$ref.lgort"/>
            </str>
            <str name="Kemasan_ID">
              <tt:value ref="$ref.kemasan"/>
            </str>
            <str name="NIE">
              <tt:value ref="$ref.nie"/>
