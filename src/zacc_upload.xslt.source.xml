            </num>
            <num name="StatusAgg">
              <tt:value ref="$ref.stsag"/>
            </num>
            <num name="StatusAck">
              <tt:value ref="$ref.stsac"/>
            </num>
            <str name="createdAt">
              <tt:value ref="$ref.crtdt"/>
            </str>
            <str name="updatedAt">
              <tt:value ref="$ref.upddt"/>
            </str>
            <str name="sapprocessid">
              <tt:value ref="$ref.sapprocessid"/>
