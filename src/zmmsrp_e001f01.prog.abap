*&---------------------------------------------------------------------*
*&      Form  F_F4_FILENAME
*&---------------------------------------------------------------------*
FORM f_f4_filename  CHANGING fc_fname.
  DATA : directory  TYPE string,
         filetable  TYPE filetable,
         line       TYPE LINE OF filetable,
         rc         TYPE i.

  CALL METHOD cl_gui_frontend_services=>get_temp_directory
    CHANGING
      temp_dir = directory.
  CALL METHOD cl_gui_frontend_services=>file_open_dialog
    EXPORTING
      window_title      = 'SELECT THE FILE'
      initial_directory = directory
      file_filter       = '*.*'
      multiselection    = ' '
    CHANGING
      file_table        = filetable
      rc                = rc.
  IF rc = 1.
    READ TABLE filetable INDEX 1 INTO line.
    fc_fname = line-filename.
  ENDIF.
ENDFORM.                    " F_F4_FILENAME

*&---------------------------------------------------------------------*
*&      Form  F_MODIFY_SCREEN
*&---------------------------------------------------------------------*
FORM f_modify_screen  USING    fu_group fu_active fu_input fu_invisible
                               fu_length.
  IF fu_active IS NOT INITIAL.
    LOOP AT SCREEN.
      IF screen-group1 = fu_group.
        screen-active  = fu_active.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.
  ENDIF.

  IF fu_input IS NOT INITIAL.
    LOOP AT SCREEN.
      IF screen-group1 = fu_group.
        screen-input  = fu_input.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.
  ENDIF.

  IF fu_invisible IS NOT INITIAL.
    LOOP AT SCREEN.
      IF screen-group1 = fu_group.
        screen-invisible  = fu_invisible.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.
  ENDIF.

  IF fu_length IS NOT INITIAL.
    LOOP AT SCREEN.
      IF screen-group1 = fu_group.
        screen-length  = fu_length.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.
  ENDIF.
ENDFORM.                    " F_MODIFY_SCREEN

*&---------------------------------------------------------------------*
*&      Form  F_ERROR_MESSAGE
*&---------------------------------------------------------------------*
FORM f_error_message  USING    fu_group fu_mess.
  DATA: lv_mess(100) VALUE 'Fill in all required entry fields'.

  IF fu_mess IS NOT INITIAL.
    lv_mess = fu_mess.
  ENDIF.

  IF fu_group IS NOT INITIAL.
    LOOP AT SCREEN.
      IF screen-group1 = fu_group.
        screen-input  = 1.
      ELSE.
        screen-input  = 0.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.
  ENDIF.

  IF lv_mess IS NOT INITIAL.
    MESSAGE e000(zab) WITH lv_mess.
  ENDIF.
ENDFORM.                    " F_ERROR_MESSAGE

*&---------------------------------------------------------------------*
*&      Form  F_GET_DATA
*&---------------------------------------------------------------------*
FORM f_get_data .
  DATA : ls_excel     LIKE LINE OF gt_excel,
         ls_prio      LIKE LINE OF gt_prio.

  CLEAR : gt_excel[].
  CALL FUNCTION 'ALSM_EXCEL_TO_INTERNAL_TABLE'
    EXPORTING
      filename                = pa_fname
      i_begin_col             = 1
      i_begin_row             = 2
      i_end_col               = 16
      i_end_row               = 60000
    TABLES
      intern                  = gt_excel
    EXCEPTIONS
      inconsistent_parameters = 1
      upload_ole              = 2
      OTHERS                  = 3.

  IF sy-subrc = 0.
    CLEAR ls_excel.
    SORT gt_excel BY row col value.
    LOOP AT gt_excel INTO ls_excel.
      CASE ls_excel-col.
        WHEN '0001'.
          PERFORM f_alpha_modify USING ls_excel-value
                                 CHANGING ls_prio-vbeln.
        WHEN '0002'.
          ls_prio-lprio = ls_excel-value.
      ENDCASE.
      AT END OF  row.
        APPEND ls_prio TO gt_prio.
        CLEAR ls_prio.
      ENDAT.
      CLEAR ls_excel.
    ENDLOOP.

    IF gt_prio[] IS NOT INITIAL.
      SELECT *
        FROM vbfa
        INTO CORRESPONDING FIELDS OF TABLE gt_vbfa
        FOR ALL ENTRIES IN gt_prio
        WHERE vbelv   = gt_prio-vbeln
          AND vbtyp_n = 'Q'.
    ENDIF.
  ENDIF.
ENDFORM.                    " F_GET_DATA

*&---------------------------------------------------------------------*
*&      Form  F_PROCESS_DATA
*&---------------------------------------------------------------------*
FORM f_process_data .
  DATA : ls_prio      LIKE LINE OF gt_prio,
         ls_out       LIKE LINE OF gt_out,
         ls_vbfa      LIKE LINE OF gt_vbfa.

  LOOP AT gt_prio INTO ls_prio.
    ls_out-vbeln  = ls_prio-vbeln.
    ls_out-lprio  = ls_prio-lprio.
    CLEAR ls_vbfa.
    READ TABLE gt_vbfa INTO ls_vbfa
                       WITH KEY vbelv = ls_prio-vbeln.
    IF sy-subrc = 0.
      ls_out-icon   = icon_led_red.
    ELSE.
      ls_out-icon   = icon_led_green.
    ENDIF.
    APPEND ls_out TO gt_out.
    CLEAR ls_out.
  ENDLOOP.
  ASSIGN gt_out TO <fs_out>.
ENDFORM.                    " F_PROCESS_DATA

