       <DEFAULT>0</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
      </RSIMP>
      <RSIMP>
       <PARAMETER>CURRENCY</PARAMETER>
       <DBFIELD>SY-WAERS</DBFIELD>
       <DEFAULT>SPACE</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
      </RSIMP>
      <RSIMP>
       <PARAMETER>FILLER</PARAMETER>
       <DEFAULT>SPACE</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
      </RSIMP>
      <RSIMP>
       <PARAMETER>LANGUAGE</PARAMETER>
       <DBFIELD>SY-LANGU</DBFIELD>
       <DEFAULT>SY-LANGU</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>IN_WORDS</PARAMETER>
