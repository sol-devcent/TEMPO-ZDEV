   <LONGTEXTS_ZSPELL_AMOUNT>
    <item>
     <DOKIL>
      <ID>FU</ID>
      <OBJECT>ZSPELL_AMOUNT</OBJECT>
      <LANGU>D</LANGU>
      <TYP>T</TYP>
      <VERSION>0016</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00040</TXTLINES>
      <DOKSTATE>R</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZSPELL_AMOUNT</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00016</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Der Funktionsbaustein SPELL_AMOUNT dient der Umsetzung eines Betrages</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>oder einer Zahl in Worte. Folgende Möglichkeiten der Anwendung</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>bestehen:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Umsetzung einer Zahl in Worte</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Dazu sind nur die Übergabeparameter LANGUAGE und AMOUNT zu füllen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Umsetzung eines Betrags in Worte</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Dazu sind die Felder LANGUAGE, CURRENCY und AMOUNT zu füllen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Vor- und Nachkommastellen eines Betrags</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Dazu sind die Parameter CURRENCY und AMOUNT zu füllen. Das Feld</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>LANGUAGE ist explizit mit dem Wert SPACE zu übergeben! Diese</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Möglichkeit wurde zur Verfügung gestellt, um das Laufzeitverhalten des</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Bausteins zu optimieren.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Die Übergabe der umgesetzten Beträge geschieht mittels der Struktur</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SPELL. In den Feldern NUMBER und DECIMAL werden die Vor- und</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Nachkommastellen, in WORD und DECWORD der Betrag in Worten und in den</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Feldern DIGnn die Ziffern in Worten eingestellt. Die in Worten</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>umgesetzten Zahlen können durch einen Stern oder andere FILLER</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>geschützt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;HINTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Bei der Benutzung der ersten zwei Möglichkeiten ist zu beachten, daß</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>stets im rufenden Programm geprüft werden muß, ob die Sprache, die zur</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Umsetzung in Worte erforderlich ist, auch gefüllt ist.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Das Programm &lt;DS:REPO.RFSSPELL&gt;RF_SPELL&lt;/&gt; enthält einen beispielhaften</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Aufruf des Funktionsbausteins und kann zu Testzwecken verwendet werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;FURTHER_SOURCES_OF_INF&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Zur Umsetzung der Zahlen in Worte wird die Tabelle</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>&lt;DS:TRAN.OBA9&gt;T015Z&lt;/&gt; (Ziffern und Zahlen in Worten) verwendet. Da die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Zahlengrammatik verschiedener Sprachen stark von der mitteleuropäischen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(speziell deutschen bzw. englischen) Zahlengrammatik abweichen können,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>sind Anpassungen notwendig. Speziell sei auf folgende Sprachen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>hingewiesen:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_P&gt;Portugiesisch&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_R&gt;Russisch&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_Q&gt;Slowakisch&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_S&gt;Spanisch&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_2&gt;Thai&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_C&gt;Tschechisch&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_3&gt;Koreanisch&lt;/&gt;</TDLINE>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>FU</ID>
      <OBJECT>ZSPELL_AMOUNT</OBJECT>
      <LANGU>E</LANGU>
      <TYP>T</TYP>
      <VERSION>0014</VERSION>
      <TXTLINES>00032</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZSPELL_AMOUNT</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00014</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Function module SPELL_AMOUNT converts an amount or number into words.</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>It can be used as follows:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Convert a number into words</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>To do this, the transfer parameters LANGUAGE and AMOUNT have to be</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>entered.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Convert an amount into words</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>To do this, the fields LANGUAGE, CURRENCY, and AMOUNT have to be</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>entered.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Set the number of places before and after the decimal point for an</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>amount</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>To do this, the parameters CURRENCY and AMOUNT have to be entered. The</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>LANGUAGE field must be transferred with the value SPACE! This option</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>optimizes the runtime of the function module.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>The structure SPELL transfers the converted amounts. The FB enters the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>number of places before and after the decimal point in the NUMBER and</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>DECIMAL fields, the amount in words in the WORD and DECWORD fields, and</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the figure in words in the DIGnn fields. The numbers converted into</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>words can be protected by a star or some other FILLER.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;HINTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>If you are using the first two functions, the system always checks</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>whether the language required for the conversion is also entered in the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>calling program.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Program &lt;DS:REPO.RFSSPELL&gt;RF_SPELL&lt;/&gt; contains a sample call of the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>function module. You can use it for test purposes.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U4</TDFORMAT>
       <TDLINE>&amp;FURTHER_SOURCES_OF_INF&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>The FB uses table &lt;DS:TRAN.OBA9&gt;T015Z&lt;/&gt; (figures and numbers in words)</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>for the conversion. You may have to modify this table since the grammar</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>for numbers in other languages may differ from the rules of grammar for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Central European numbers (especially between German and English). Take</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>note of the following languages:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_P&gt;Portuguese&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>&lt;DS:TX.FI_SPELL_AMOUNT_R&gt;Russian&lt;/&gt;</TDLINE>
