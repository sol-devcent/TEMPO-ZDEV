      </RSFDO>
      <RSFDO>
       <PARAMETER>FILLER</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Filler with which the output field is entered</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>LANGUAGE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Language indicator for conversion in words</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IN_WORDS</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Field string with amount/number and figure in words</STEXT>
      </RSFDO>
      <RSFDO>
