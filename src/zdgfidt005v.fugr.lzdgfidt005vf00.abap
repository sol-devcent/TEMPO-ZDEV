*...processing: ZDGFIDT005V.....................................*
FORM GET_DATA_ZDGFIDT005V.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZDGFIDT005 WHERE
(VIM_WHERETAB) .
    CLEAR ZDGFIDT005V .
ZDGFIDT005V-MANDT =
ZDGFIDT005-MANDT .
ZDGFIDT005V-VERSN =
ZDGFIDT005-VERSN .
ZDGFIDT005V-STROW =
ZDGFIDT005-STROW .
ZDGFIDT005V-HKONT =
ZDGFIDT005-HKONT .
ZDGFIDT005V-SHKZG =
ZDGFIDT005-SHKZG .
    SELECT * FROM SKA1 WHERE
SAKNR = ZDGFIDT005-HKONT .
      SELECT SINGLE * FROM SKAT WHERE
KTOPL = SKA1-KTOPL AND
SAKNR = SKA1-SAKNR AND
SPRAS = SY-LANGU .
      IF SY-SUBRC EQ 0.
ZDGFIDT005V-TXT20 =
SKAT-TXT20 .
      ENDIF.
      EXIT.
    ENDSELECT.
<VIM_TOTAL_STRUC> = ZDGFIDT005V.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZDGFIDT005V .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZDGFIDT005V.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZDGFIDT005V-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZDGFIDT005 WHERE
  VERSN = ZDGFIDT005V-VERSN AND
  STROW = ZDGFIDT005V-STROW AND
  HKONT = ZDGFIDT005V-HKONT .
    IF SY-SUBRC = 0.
    DELETE ZDGFIDT005 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZDGFIDT005 WHERE
  VERSN = ZDGFIDT005V-VERSN AND
  STROW = ZDGFIDT005V-STROW AND
  HKONT = ZDGFIDT005V-HKONT .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZDGFIDT005.
    ENDIF.
ZDGFIDT005-MANDT =
ZDGFIDT005V-MANDT .
ZDGFIDT005-VERSN =
ZDGFIDT005V-VERSN .
ZDGFIDT005-STROW =
ZDGFIDT005V-STROW .
ZDGFIDT005-HKONT =
ZDGFIDT005V-HKONT .
ZDGFIDT005-SHKZG =
ZDGFIDT005V-SHKZG .
    IF SY-SUBRC = 0.
    UPDATE ZDGFIDT005 .
    ELSE.
    INSERT ZDGFIDT005 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZDGFIDT005V-UPD_FLAG,
STATUS_ZDGFIDT005V-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
