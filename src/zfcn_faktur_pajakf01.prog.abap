*&---------------------------------------------------------------------*
*&      Form  F_ALV_VARIANT_EXIST
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM f_alv_variant_exist USING     fu_vari
                         CHANGING  fc_alv_variant STRUCTURE disvariant.
  IF NOT fu_vari IS INITIAL.
    MOVE fu_vari TO fc_alv_variant-variant.
    fc_alv_variant-report = d_repid.
    CALL FUNCTION 'REUSE_ALV_VARIANT_EXISTENCE'
      EXPORTING
        i_save        = 'A'
      CHANGING
        cs_variant    = fc_alv_variant
      EXCEPTIONS
        wrong_input   = 1
        not_found     = 2
        program_error = 3
        OTHERS        = 4.
    IF sy-subrc <> 0.
      IF NOT sy-msgid IS INITIAL.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.
    ENDIF.
  ELSE.
    CLEAR fc_alv_variant.
    fc_alv_variant-report = sy-repid.
  ENDIF.
ENDFORM.                    " F_ALV_VARIANT_EXIST

*&---------------------------------------------------------------------*
*&      Form  f_process_data
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM f_process_data.
  DATA: BEGIN OF lines OCCURS 0.
          INCLUDE STRUCTURE tline.
  DATA: END OF lines.
  DATA: name  LIKE thead-tdname,
        id    LIKE thead-tdid.

  SORT t_vbrk BY knkli.
  SORT t_kna1vv BY kunnr.
  LOOP AT t_vbrk.
    READ TABLE t_kna1vv WITH KEY kunnr = t_vbrk-knkli
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      t_itab-vkbur  = t_kna1vv-vkbur.
      t_itab-knkli  = t_vbrk-knkli.
      t_itab-name1  = t_kna1vv-name1.
      name  = t_itab-vbeln  = t_vbrk-vbeln.
      t_itab-fkdat  = t_vbrk-fkdat.

      id  = 'Z001'.
      PERFORM f_read_text TABLES lines
                          USING id name.
      IF lines[] IS NOT INITIAL.
        REFRESH: lines.
        CLEAR: lines.
        id  = 'Z008'.
        PERFORM f_read_text TABLES lines
                            USING id name.
        IF lines[] IS NOT INITIAL.
          READ TABLE lines INDEX 1.
          t_itab-text  = lines-tdline.
        ENDIF.
        APPEND t_itab.
        CLEAR: t_itab.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " f_process_data

