*---------------------------------------------------------------------*
*       FORM f_get_data                                               *
*---------------------------------------------------------------------*
*       ........                                                      *
*---------------------------------------------------------------------*
FORM f_get_data.
  SELECT vbeln fkart fkdat knkli
  FROM vbrk
  INTO CORRESPONDING FIELDS OF TABLE t_vbrk
  WHERE vbeln IN so_vbeln  AND
        fkart LIKE 'ZC%'   AND
        fkdat IN so_fkdat  AND
        knkli IN so_knkli.

  t_knkli[]  = t_vbrk[].
  SORT t_knkli BY knkli.
  DELETE ADJACENT DUPLICATES FROM t_knkli COMPARING knkli.
  IF t_knkli[] IS NOT INITIAL.
    SELECT kunnr name1 vkbur
      FROM kna1vv
      INTO CORRESPONDING FIELDS OF TABLE t_kna1vv
      FOR ALL ENTRIES IN t_knkli
      WHERE kunnr EQ t_knkli-knkli AND
            vkbur IN so_vkbur.
  ENDIF.
ENDFORM.                    "f_get_data

